# Qwen AI ignore patterns
# These files should be ignored by Qwen AI

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp

# Test coverage
.coverage
htmlcov/
.coverage.*

# IDE
.vscode/
.idea/

# Build artifacts
dist/
build/
*.egg-info/
target/
.gradle/

# OS files
.DS_Store
Thumbs.db

# Ruff cache
.ruff_cache/

# Mypy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# AI specific
.ai/.agent_active
tempCodeRunnerFile.py
