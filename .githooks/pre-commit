# .githooks/pre-commit
# Быстрые статические проверки перед коммитом
# Блокирует коммит при любом сбое проверок.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[pre-commit]${NC} $*"; }
warn()  { echo -e "${YELLOW}[pre-commit]${NC} $*"; }
fail()  { echo -e "${RED}[pre-commit]${NC} $*"; exit 1; }


# ──────────────────────────────────────────────
# 1. Статические проверки (ВСЕГДА при коммите)
# ──────────────────────────────────────────────

info "🤖 Запуск статических проверок перед коммитом..."

# 1. Ruff lint
# Fail-closed: отсутствие инструмента — это НЕ пропуск проверки. Молчаливый
# skip создавал видимость зелёного света (тот же класс бага, что был исправлен
# в check_gitignore.sh). Обход: ATOMIC_SKIP=1.
info "📏 Running ruff lint..."
if [[ -n "${ATOMIC_SKIP:-}" ]]; then
    warn "ATOMIC_SKIP set — пропуск ruff lint"
elif ! command -v ruff &>/dev/null; then
    fail "❌ ruff не найден — проверка не выполнена. Установи: pip install -e \".[dev]\" (обход: ATOMIC_SKIP=1)"
elif ! ruff check .; then
    fail "❌ Ruff lint failed"
fi

# 2. Ruff format
info "🎨 Running ruff format..."
if [[ -n "${ATOMIC_SKIP:-}" ]]; then
    warn "ATOMIC_SKIP set — пропуск ruff format"
elif ! command -v ruff &>/dev/null; then
    fail "❌ ruff не найден — проверка не выполнена. Установи: pip install -e \".[dev]\" (обход: ATOMIC_SKIP=1)"
elif ! ruff format . --check; then
    fail "❌ Ruff format failed"
fi

## 3. MyPy type checking
#info "🔍 Running mypy..."
#if command -v mypy &>/dev/null; then
#    # Используем MYPYPATH для корректной работы с src/ структурой
#    if ! MYPYPATH=src mypy src/; then
#        fail "❌ MyPy failed"
#    fi
#else
#    warn "mypy not found, skipping type check..."
#fi

# 4. Проверка .gitignore
info "📝 Checking .gitignore..."
# Проверка обязательна, а не условна: `[[ -x ... ]]` молча пропускал отсутствующий
# скрипт, и .gitignore можно было править беспрепятственно — при том что правила
# проекта это запрещают. Отсутствие проверки выглядело как «проверка прошла».
if [[ ! -x "$ROOT/.ai/scripts/check_gitignore.sh" ]]; then
    fail "❌ Скрипт проверки .gitignore отсутствует или не исполняем: .ai/scripts/check_gitignore.sh"
fi
if ! "$ROOT/.ai/scripts/check_gitignore.sh"; then
    fail "❌ Gitignore check failed"
fi

# 5. Проверка обновления документации
info "📚 Checking documentation updates..."
if [[ -x "$ROOT/.ai/scripts/check_docs_updated.py" ]]; then
    if ! python "$ROOT/.ai/scripts/check_docs_updated.py"; then
        fail "❌ Documentation check failed"
    fi
fi

# 6. Атомарность: размер дифа по коду ≤ 500 строк (конституция v3.0.0)
# Один коммит = одна логическая задача. Проверяются только src/ и tests/:
# документации и ROADMAP этот лимит не ограничивают.
info "⚛️  Checking atomicity (diff ≤ 500 lines)..."
if [[ -n "${ATOMIC_SKIP:-}" ]]; then
    warn "ATOMIC_SKIP set — пропуск проверки размера дифа"
else
    diff_size=$(git diff --cached --numstat -- src tests \
        | awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { n += $1 + $2 } END { print n + 0 }')
    if (( diff_size > 500 )); then
        fail "❌ Диф по коду: $diff_size строк (>500). Разбей на атомарные коммиты (одна задача = серия test → feat → docs). Обход в крайнем случае: ATOMIC_SKIP=1 git commit ..."
    fi
    info "⚛️  Diff по коду: $diff_size/500 строк"
fi

# 7. Фронтенд нового интерфейса (спека 017). Проверки запускаются только когда
#    в коммит попали файлы frontend/ — иначе каждый коммит платил бы за сборку
#    фронтенда. Репозиторий использует .githooks, а не pre-commit-фреймворк,
#    поэтому проверки продублированы здесь, а не только в .pre-commit-config.yaml.
if git diff --cached --name-only | grep -q '^frontend/'; then
    info "🧩 Проверка фронтенда (eslint, tsc, vitest)..."
    if ! command -v pnpm &>/dev/null; then
        warn "pnpm не найден — проверка фронтенда пропущена (установи pnpm)"
    else
        if ! (cd "$ROOT/frontend" && pnpm exec eslint && pnpm exec tsc --noEmit); then
            fail "❌ Фронтенд: eslint/tsc не прошли"
        fi
        if ! (cd "$ROOT/frontend" && pnpm exec vitest run --reporter=dot); then
            fail "❌ Фронтенд: тесты не прошли"
        fi
    fi
fi

info "✅ Все статические проверки пройдены"

# ──────────────────────────────────────────────
# 2. Обновление статусов задач и синхронизация ROADMAP
# ──────────────────────────────────────────────
info "Обновление статусов задач в ROADMAP..."

if [[ -x "$ROOT/.ai/scripts/sync_roadmap.py" ]]; then
    # Сначала обновляем статусы задач на основе наличия файлов
    info "🔄 Проверяем выполнение задач по наличию файлов кода..."
    python "$ROOT/.ai/scripts/sync_roadmap.py" --auto-update

    # Затем проверяем актуальность ROADMAP.md
    if ! python "$ROOT/.ai/scripts/sync_roadmap.py" --check-only; then
        warn "ROADMAP требует обновления!"
        info "Автоматическое обновление ROADMAP..."
        python "$ROOT/.ai/scripts/sync_roadmap.py"

        # Проверяем, есть ли изменения в ROADMAP после синхронизации
        if ! git diff --quiet "$ROOT/.ai/03_ROADMAP.md" 2>/dev/null; then
            warn "⚠️  ROADMAP был обновлен автоматически!"
            warn "   Добавь изменения в ROADMAP в этот коммит:"
            warn "   git add .ai/03_ROADMAP.md"
            warn ""
            warn "   Затем повтори коммит."
            fail "ROADMAP обновлен — добавь изменения в коммит"
        fi
    else
        info "✅ ROADMAP актуален"
    fi
else
    warn "sync_roadmap.py не найден — пропускаю проверку ROADMAP"
fi

info "✅ Все проверки пройдены ✓"
exit 0
