# .githooks/pre-commit
# Husky-like pre-commit hook for smart-home-platform.
# Блокирует коммит при любом сбое проверок.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[pre-commit]${NC} $*"; }
warn()  { echo -e "${YELLOW}[pre-commit]${NC} $*"; }
fail()  { echo -e "${RED}[pre-commit]${NC} $*"; exit 1; }


# ──────────────────────────────────────────────
# 1. Проверка: запуск quality checks (только если AI=1)
# ──────────────────────────────────────────────

if [[ "${AI:-}" == "1" ]]; then
    info "🤖 AI mode enabled — запуск проверок качества (.ai/scripts/run_checks.sh)..."
    
    if [[ ! -x "$ROOT/.ai/scripts/run_checks.sh" ]]; then
        fail "Скрипт проверок не найден или не исполняемый: .ai/scripts/run_checks.sh"
    fi
    
    # Запускаем проверки ТОЛЬКО если есть изменения в staged
    if git diff --cached --quiet src/ tests/ 2>/dev/null; then
        info "Нет изменений в src/ или tests/ — пропускаем проверки кода"
    else
        info "Обнаружены изменения в коде — запускаем проверки..."
        if ! "$ROOT/.ai/scripts/run_checks.sh"; then
            fail "❌ Проверки качества не пройдены! Исправь ошибки перед коммитом."
        fi
        info "✅ Все проверки качества пройдены"
    fi
else
    info "ℹ️  AI mode disabled. Set AI=1 to run quality checks."
    info "   Example: AI=1 git commit -m \"message\""
fi

# ──────────────────────────────────────────────
# 2. Автоматическая синхронизация ROADMAP
# ──────────────────────────────────────────────
info "Проверка актуальности ROADMAP..."

if [[ -x "$ROOT/.ai/scripts/sync_roadmap.py" ]]; then
    # Запускаем синхронизацию ROADMAP
    if ! python "$ROOT/.ai/scripts/sync_roadmap.py" --check-only; then
        warn "ROADMAP требует обновления!"
        info "Автоматическое обновление ROADMAP..."
        python "$ROOT/.ai/scripts/sync_roadmap.py" --auto-update
        
        # Проверяем, есть ли изменения в ROADMAP после синхронизации
        if ! git diff --quiet "$ROOT/.ai/03_ROADMAP.md" 2>/dev/null; then
            warn "⚠️  ROADMAP был обновлен автоматически!"
            warn "   Добавь изменения в ROADMAP в этот коммит:"
            warn "   git add .ai/03_ROADMAP.md"
            warn ""
            warn "   Затем повтори коммит."
            fail "ROADMAP обновлен — добавь изменения в коммит"
        fi
    else
        info "✅ ROADMAP актуален"
    fi
else
    warn "sync_roadmap.py не найден — пропускаю проверку ROADMAP"
fi

# ──────────────────────────────────────────────
# 3. Стандартные pre-commit проверки
# ──────────────────────────────────────────────
info "Запуск дополнительных pre-commit проверок..."

if command -v pre-commit &>/dev/null && [[ -f "$ROOT/.pre-commit-config.yaml" ]]; then
    if ! pre-commit run --all-files; then
        fail "pre-commit checks failed"
    fi
elif [[ -f "$ROOT/.pre-commit-config.yaml" ]]; then
    # fallback: docker (только если docker доступен)
    if command -v docker &>/dev/null; then
        if ! docker run --rm -v "$ROOT:/src" -w /src \
            pre-commit/pre-commit:latest \
            run --all-files; then
            fail "pre-commit checks failed (docker)"
        fi
    else
        warn "Docker не доступен — пропускаю pre-commit проверки"
    fi
else
    warn ".pre-commit-config.yaml не найден — пропускаю"
fi

info "✅ Все проверки пройдены ✓"
exit 0
