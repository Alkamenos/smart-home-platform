# .githooks/pre-push
# Полные проверки качества перед пушем (тесты + линтер + покрытие)
# Блокирует пуш при любом сбое проверок.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[pre-push]${NC} $*"; }
warn()  { echo -e "${YELLOW}[pre-push]${NC} $*"; }
fail()  { echo -e "${RED}[pre-push]${NC} $*"; exit 1; }


# ──────────────────────────────────────────────
# Проверка: запуск full quality checks (ВСЕГДА при пуше)
# ──────────────────────────────────────────────

info "🤖 Запуск полных проверок качества перед пушем..."

if [[ ! -x "$ROOT/.ai/scripts/run_checks.sh" ]]; then
    fail "Скрипт проверок не найден или не исполняемый: .ai/scripts/run_checks.sh"
fi

info "Запускаем run_checks.sh (тесты + линтер + покрытие)..."
if ! "$ROOT/.ai/scripts/run_checks.sh"; then
    fail "❌ Проверки качества не пройдены! Исправь ошибки перед пушем."
fi

info "✅ Все проверки качества пройдены"

# ──────────────────────────────────────────────
# Секрет-скан (gitleaks): токены/ключи не доезжают до remote
# ──────────────────────────────────────────────

info "🔐 Секрет-скан (gitleaks)..."
if [[ -n "${ATOMIC_SKIP:-}" ]]; then
    warn "ATOMIC_SKIP set — пропуск секрет-скана"
elif command -v gitleaks &>/dev/null; then
    # Сканируются коммиты, которые уходят в remote (старые уже проверены CI),
    # и staged-состояние на случай немигрированных секретов в индексе.
    if ! gitleaks git --redact --log-opts="origin/main..HEAD" 2>/dev/null \
        && ! gitleaks detect --source . --redact --no-banner 2>/dev/null; then
        fail "❌ gitleaks нашёл возможный секрет! См. вывод выше.
Обход только если найден ложный срабатыватель: ATOMIC_SKIP=1 git push ..."
    fi
    info "✅ Секрет-скан пройден"
else
    fail "❌ gitleaks не найден — секрет-скан не выполнен.
Установи: brew install gitleaks  (macOS) или https://github.com/gitleaks/gitleaks
CI (job secret-scan) сканирует историю независимо, но локальный скан раньше и дешевле."
fi

info "✅ Pre-push проверки пройдены ✓"
exit 0
