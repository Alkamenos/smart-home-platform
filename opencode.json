{
    "$schema": "https://opencode.ai/config.json",
    "shell": "/bin/zsh",
    "lsp": true,
    "formatter": {
        "ruff": {
            "command": [
                "ruff",
                "format",
                "$FILE"
            ]
        }
    },
    "watcher": {
        "ignore": [
            ".mypy_cache/**",
            ".ruff_cache/**",
            ".pytest_cache/**",
            ".fsm_output/**",
            "coverage.xml",
            "htmlcov/**",
            "instances/**",
            "data/**"
        ]
    },
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "ruff *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "mypy *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "pytest *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "python -m pytest *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "pre-commit *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "coverage *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "make *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "shp *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git status *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git diff *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git log *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git show *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git branch *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git add *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git commit *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git restore *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git reset *",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git push *",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "pip install *",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "uv pip *",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "rm *",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "docker *",
            "effect": "ask"
        },
        {
            "action": "webfetch",
            "resource": "http://localhost*",
            "effect": "allow"
        },
        {
            "action": "webfetch",
            "resource": "http://127.0.0.1*",
            "effect": "allow"
        }
    ],
    "provider": {
        "odirouter": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "OdiRouter",
            "options": {
                "baseURL": "https://api.odirouter.ai/v1"
            },
            "models": {
                "gpt-5.6-sol": {
                    "name": "GPT-5.6 SOL"
                },
                "claude-sonnet-5": {
                    "name": "Claude Sonnet 5"
                },
                "claude-haiku-4-5-20251001": {},
                "free-claude-haiku-4.5": {},
                "claude-haiku-4-5": {},
                "gemini-3.5-flash": {},
                "glm-5.3-flash": {}
            }
        }
    },
    "model": "odirouter/free-claude-haiku-4.5"
}
