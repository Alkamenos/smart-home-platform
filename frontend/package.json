        "@vitest/coverage-v8": "^5.0.4",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "jsdom": "^30.1.2",
        "msw": "^3.0.3",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^5.0.4"
