        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tanstack/react-query": "^5.104.2",
        "@tanstack/react-virtual": "^3.14.18",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.23",
        "lucide-react": "^1.56.0",
        "mermaid": "^12.2.0",
        "next": "16.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
