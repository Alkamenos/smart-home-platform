{
    "name": "smart-home-webui",
    "version": "0.1.0",
    "private": true,
    "description": "Веб-интерфейс инженера: состояние дома, автоматика, журнал (спека 017)",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
