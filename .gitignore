```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled files
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors and IDEs
.vscode/
.idea/

# Coverage reports
.coverage
htmlcov/
coverage/

# Build artifacts
dist/
build/
target/
*.class

# Package management
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# OS generated files
.DS_Store
Thumbs.db
```