# deploy/docker/.env.example — образец файла конфигурации.
#
# Скопируйте в .env и заполните значениями:
#   cp deploy/docker/.env.example deploy/docker/.env
#
# Файл НЕ должен попадать в git. Он содержит токен Home Assistant.
#
# Это ЕДИНСТВЕННЫЙ источник конфигурации развёртывания. Раньше рядом лежал
# ещё и .env.prod с другими значениями, а блок environment: в docker-compose
# имел приоритет над env_file — из-за этого .env.prod был мёртвым: правки в
# нём не давали эффекта. Проверено запуском контейнера.

# ─── Home Assistant ───────────────────────────────────────────────────────────
# Обязательные. Без HA_TOKEN платформа не сможет обращаться к источнику.
# Токен создаётся в HA: Профиль → Длинные токены доступа.
HA_URL=http://<адресу-HA>:8123
HA_WEBSOCKET_URL=ws://<адресу-HA>:8123/api/websocket
HA_TOKEN=<длинный-токен-из-HA>

# ─── Ключ шифрования токенов ─────────────────────────────────────────────────
# НЕОБЯЗАТЕЛЕН: если переменная не задана, платформа создаёт файл ключа
# encryption.key в томе данных и берёт ключ из него. Файл переживает
# перезапуск и пересоздание контейнера.
#
# Задавайте переменную только если хотите хранить ключ вне тома (например, в
# системе секретов). Приоритет: переменная → файл ключа → создание файла.
#
# Чего переменная больше НЕ делает: раньше её отсутствие означало, что ключ
# генерируется заново при каждом старте. Из-за этого токены не просто
# становились недоступны — они разрушались: при неудачной расшифровке
# платформа молча подставляла шифротекст вместо токена, и каждая последующая
# запись шифровала его ещё раз. Доказано прогоном: после двух перезапусков
# значение не расшифровывалось ни одним ключом.
#
# Путь к файлу ключа, если нужно переопределить (по умолчанию
# <DATA_PATH>/encryption.key):
# ENCRYPTION_KEY_PATH=/config/behavioral_platform/encryption.key
#
# ВАЖНО: файл ключа обязан попасть в резервные копии вместе с данными. Без
# него сохранённые токены расшифровать невозможно — ключ не восстанавливается.
# `deploy.sh backup` копирует весь каталог данных, поэтому ключ включается
# автоматически.
#
# Сгенерировать заранее, если нужно положить свой ключ:
#   python -c "from core.security.encryption import generate_encryption_key; print(generate_encryption_key())"
HOME_ASSISTANT_ENCRYPTION_KEY=

# ─── Режим работы ─────────────────────────────────────────────────────────────
# SHADOW_MODE=true — платформа считает состояния, но не вмешивается: команды
# пишутся в журнал как `[DRY RUN]` и в Home Assistant не уходят.
#
# Оставлено `true` осознанно: дом ещё настраивается, и платформа не должна
# трогать реальные лампы, пока настройка не закончена. Проверить, в каком
# режиме платформа сейчас, можно запросом:
#
#   curl -s localhost:8125/ready | python3 -m json.tool
#
# В режиме тени `/ready` отвечает 503 и называет причину в `deployment_mode` —
# это правильный ответ, а не поломка. Чтобы включить выход в Home Assistant,
# поставьте `SHADOW_MODE=false` и перезапустите контейнер.
SHADOW_MODE=true

# DEBUG нужен, чтобы видеть сообщения HA в логах контейнера. Отладочный вывод
# библиотеки WebSocket при этом не пишется: `websockets` на DEBUG выдаёт бинарный
# обмен (`> PING b3 d2 62 82 [binary, 4 bytes]`) на каждое сообщение, и это
# было 80% объёма журнала. Вернуть его можно флагом ниже.
LOG_LEVEL=DEBUG

# ─── Диагностика (обычно не нужно) ────────────────────────────────────────────
# FSM_LOG_REJECTIONS=1 — писать в журнал каждый отказ перехода, а не только
# первое упоминание сущности. Полезно при разборе, почему не сработал
# переход: по умолчанию повторные отказы одной сущности молчат, потому что в
# доме синхронизировано больше сущностей, чем описано в манифесте, и каждый
# отказ писался тысячи раз. Общее число отказов по причинам доступно всегда в
# `FSMEngine.rejection_counts()` и в таблице `fsm_transitions`.
# Значение имеет силу только «да»: 1, true, yes, on. Опечатка шум не включает.
# FSM_LOG_REJECTIONS=1

# FSM_LOG_LIBRARY_DEBUG=1 — вернуть отладочный вывод библиотек, в том числе
# бинарный обмен WebSocket. Тот же формат значений, что выше.
# FSM_LOG_LIBRARY_DEBUG=1

# Порт веб-интерфейса на хосте. Внутри контейнера всегда 8125.
WEBUI_PORT=8125

# ─── НЕ ЗДЕСЬ ─────────────────────────────────────────────────────────────────
# CONFIG_PATH и DATA_PATH заданы в docker-compose.prod.yml и указывают на
# точки монтирования томов:
#   CONFIG_PATH=/config/behavioral_platform  ← монтируется из ./config
#   DATA_PATH=/data/behavioral_platform     ← монтируется из ./data
#
# Задавать их здесь нельзя. Раньше в .env стояло
# CONFIG_PATH=/app/instances/leonids_house — каталог в слое контейнера, а не в
# томе, поэтому правки манифеста из интерфейса молча откатывались при каждом
# `docker compose down && up -d` (проверено хешем файла).
#
# Первый запуск переносит конфигурацию из образа в ./config, если каталог
# пуст; последующие запуски данные не трогают.
