# deploy/docker/.env.example — образец файла конфигурации.
#
# Скопируйте в .env и заполните значениями:
#   cp deploy/docker/.env.example deploy/docker/.env
#
# Файл НЕ должен попадать в git. Он содержит токен Home Assistant.
#
# Это ЕДИНСТВЕННЫЙ источник конфигурации развёртывания. Раньше рядом лежал
# ещё и .env.prod с другими значениями, а блок environment: в docker-compose
# имел приоритет над env_file — из-за этого .env.prod был мёртвым: правки в
# нём не давали эффекта. Проверено запуском контейнера.

# ─── Home Assistant ───────────────────────────────────────────────────────────
# Обязательные. Без HA_TOKEN платформа не сможет обращаться к источнику.
# Токен создаётся в HA: Профиль → Длинные токены доступа.
HA_URL=http://<адресу-HA>:8123
HA_WEBSOCKET_URL=ws://<адресу-HA>:8123/api/websocket
HA_TOKEN=<длинный-токен-из-HA>

# ─── Ключ шифрования токенов ─────────────────────────────────────────────────
# ОБЯЗАТЕЛЕН для продакшена, иначе токены не переживают перезапуск.
#
# Без этой переменной ключ генерируется заново при каждом старте
# (encryption.py:31). Проверено в контейнере: два запуска подряд дали разные
# ключи (30f7b31f32c1 и 501bac3adf46), то есть сохранённый токен после
# перезапуска не расшифровывается.
#
# Сгенерировать:
#   python -c "from core.security.encryption import generate_encryption_key; print(generate_encryption_key())"
#
# Хранить нужно в секрете, а не в этом файле, если в вашей схеме есть
# отдельное хранилище. Потеря ключа означает потерю всех сохранённых токенов.
HOME_ASSISTANT_ENCRYPTION_KEY=

# ─── Режим работы ─────────────────────────────────────────────────────────────
# SHADOW_MODE=true — платформа считает, но не вмешивается.
# По умолчанию в compose стоит false; задавайте здесь.
SHADOW_MODE=true

# DEBUG нужен, чтобы видеть сообщения HA в логах контейнера.
LOG_LEVEL=DEBUG

# Порт веб-интерфейса на хосте. Внутри контейнера всегда 8125.
WEBUI_PORT=8125

# ─── НЕ ЗДЕСЬ ─────────────────────────────────────────────────────────────────
# CONFIG_PATH и DATA_PATH заданы в docker-compose.prod.yml и указывают на
# точки монтирования томов:
#   CONFIG_PATH=/config/behavioral_platform  ← монтируется из ./config
#   DATA_PATH=/data/behavioral_platform     ← монтируется из ./data
#
# Задавать их здесь нельзя. Раньше в .env стояло
# CONFIG_PATH=/app/instances/leonids_house — каталог в слое контейнера, а не в
# томе, поэтому правки манифеста из интерфейса молча откатывались при каждом
# `docker compose down && up -d` (проверено хешем файла).
#
# Первый запуск переносит конфигурацию из образа в ./config, если каталог
# пуст; последующие запуски данные не трогают.
