# .env.example для Behavioral Platform
# Скопируйте этот файл в .env и заполните значениями

# Home Assistant Configuration
HA_URL=http://localhost:8123
HA_TOKEN=your_long_lived_access_token_here

# Platform Configuration
LOG_LEVEL=INFO
FORCE_COLOR=true          # Раскраска логов в Docker (true/false)
SHADOW_MODE=false
CONFIG_PATH=/config/behavioral_platform
DATA_PATH=/data/behavioral_platform

# Database (опционально, если используется)
# DB_URL=sqlite:///data/behavioral_platform/platform.db

# Metrics and Monitoring
# Показатели отдаются на порту платформы: GET http://<host>:8125/metrics
# Отдельного порта показателей нет — наблюдаемость не должна быть второй
# точкой отказа.
METRICS_ENABLED=true          # Сбор показателей (true/false), по умолчанию включён

# Watchdog: периодические снимки состояний автоматов и обнаружение зависаний
WATCHDOG_ENABLED=true                       # Сторож (true/false), по умолчанию включён
WATCHDOG_INTERVAL_SEC=60                   # Интервал проверок; не число/ноль/минус -> 60
WATCHDOG_STUCK_GRACE_SEC=30                 # Запас сверх ожидаемого времени пребывания
WATCHDOG_HA_LOSS_SEC=300                    # Порог потери связи с Home Assistant

# Синхронизация источников. Периодической синхронизации нет: она запускается
# вручную (POST /api/v1/devices/sources/{id}/sync), поэтому дата последнего
# обновления не растёт сама. /ready сообщает о протухших данных по этому порогу.
# Не число/ноль/минус -> 86400 (сутки).
SYNC_STALE_SEC=86400

# Фильтр сущностей при синхронизации. По умолчанию ВЫКЛЮЧЕН, и это не
# осторожность: фильтр меняет контракт — синхронизация перестаёт быть способом
# узнать о новом устройстве и только обновляет уже описанное (добавляет
# устройство мастер discovery). Включение ломает 38 тестов, которые проверяют
# нынешний контракт, поэтому включать нужно осознанно.
# При включении в базу попадают только сущности манифеста и уже известные
# сервису: в бою Home Assistant отдаёт 1502 сущности против 6 описанных.
SYNC_FILTER_MANIFEST_ONLY=false

# Security
# SECRET_KEY=your_secret_key_here
